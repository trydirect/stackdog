#APP_HOST=localhost
# in container
APP_HOST=0.0.0.0

APP_PORT=5000
DATABASE_URL=stackdog.db
RUST_BACKTRACE=full

# Log Sniff Configuration
#STACKDOG_LOG_SOURCES=/var/log/syslog,/var/log/auth.log,/var/log/nginx/access.log
#STACKDOG_SNIFF_INTERVAL=30
#STACKDOG_SNIFF_OUTPUT_DIR=./stackdog-logs/
#STACKDOG_SERVE_SNIFF_ENABLED=true

# AI Provider Configuration
# Supports OpenAI, Ollama (http://localhost:11434/v1), or any OpenAI-compatible API
# `stackdog serve` defaults to the local pattern analyzer unless you override this.
#STACKDOG_AI_PROVIDER=openai
#STACKDOG_AI_API_URL=http://localhost:11434/v1
#STACKDOG_AI_API_KEY=
#STACKDOG_AI_MODEL=llama3

# How long the same finding stays suppressed before it alerts again (seconds).
# Default 21600 (6h). Standing misconfigurations are re-detected every pass, so
# a short window means the same alert all day.
#STACKDOG_ALERT_DEDUP_WINDOW_SECS=21600

# Dashboard base URL. When set, every notification carries a link straight to
# the alert (<url>/#alerts/{id}). Point it at the UI container, not the API.
#STACKDOG_UI_URL=https://stackdog.example.com

# Notification Channels
# Slack: create an incoming webhook at https://api.slack.com/messaging/webhooks
#STACKDOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxxxx
# Slack sender identity. Only honored by legacy custom-integration webhooks or a
# bot token with chat:write.customize; Slack-app webhooks use the app's own name
# and icon, which you set under Basic Information > Display Information.
#STACKDOG_SLACK_USERNAME=Stackdog
# Defaults to https://stackdog.app/stackdog-mark.png, falling back to the
# GitHub raw copy if that host does not answer. Setting this skips the probe.
#STACKDOG_SLACK_ICON_URL=https://stackdog.app/stackdog-mark.png
# Generic webhook endpoint for alert notifications
#STACKDOG_WEBHOOK_URL=https://example.com/webhook
#STACKDOG_SMTP_HOST=smtp.example.com
#STACKDOG_SMTP_PORT=587
#STACKDOG_SMTP_USER=alerts@example.com
#STACKDOG_SMTP_PASSWORD=secret
#STACKDOG_EMAIL_RECIPIENTS=soc@example.com,oncall@example.com
# Identity shown as "Instance" in notifications — say which host sent the
# alert. Falls back to the machine hostname when unset; set this explicitly
# for stable names in a fleet.
#STACKDOG_NOTIFICATION_LABEL=prod-eu-1
#STACKDOG_NOTIFICATION_MIN_SEVERITY=critical
#
# Action notification toggles
#STACKDOG_NOTIFY_IP_BAN_ACTIONS=true

# Never ban these, whatever the logs say. Comma-separated, bare addresses or
# CIDR notation. Put load balancers, health checkers and VPN gateways here:
# banning them takes the service down with them. Empty by default.
#STACKDOG_IP_BAN_ALLOWLIST=167.233.9.19,10.0.0.0/8
# Ceiling on blocks per minute. A burst is far more often a misread log than a
# crowd of attackers; the ceiling caps the damage. 0 disables it.
#STACKDOG_IP_BAN_MAX_PER_MINUTE=10
# Whether findings written by the AI analyzer may trigger a ban. Detector-backed
# findings are unaffected. Set to false to ban only on deterministic detectors.
#STACKDOG_IP_BAN_FROM_AI_FINDINGS=true
# Never ban addresses of this host or its containers (interface addresses, docker
# network subnets). A DROP rule for one of those severs the service from itself.
# Off only to block a local address deliberately.
#STACKDOG_IP_BAN_PROTECT_LOCAL_IPS=true
#STACKDOG_NOTIFY_QUARANTINE_ACTIONS=true

# Mail abuse guard. The traffic heuristic alone matches ordinary HTTP/JSON
# chatter between microservices, so quarantine (a network disconnect) requires
# observed SMTP egress (ports 25/465/587 in the conntrack table) on top of it.
# A match without SMTP evidence is an alert. Set to false to quarantine on the
# traffic heuristic alone.
#STACKDOG_MAIL_GUARD_REQUIRE_SMTP=true

# PHP shell detection. Scans PHP files in web roots for webshell code and
# watches access logs for requests to them. A flagged file is an alert; a
# request that drives a shell (POST to PHP under an uploads/ URL, parameters
# sent to a flagged file) feeds the IP ban like any other detector finding.
# false turns off both the scan and the access-log detector.
#STACKDOG_PHPSHELL_ENABLED=true
# Host web roots to scan. Containers are found on their own (see below).
#STACKDOG_PHPSHELL_PATHS=/var/www
# Container name/image fragments that mark a PHP workload. Any container with
# something mounted at /var/www, /srv, /app or /usr/share/nginx/html is scanned
# as well, whatever its name.
#STACKDOG_PHPSHELL_CONTAINERS=php,wordpress,drupal,joomla,laravel,magento,apache,httpd
# Where the host filesystem is mounted when Stackdog runs in a container
# (- /:/host:ro). Needed to read host paths and container docroots.
#STACKDOG_HOST_ROOT=/host
#STACKDOG_PHPSHELL_SKIP_DIRS=vendor,node_modules,.git
#STACKDOG_PHPSHELL_MAX_FILE_BYTES=2097152
# Extra signatures, JSON: [{"id","description","pattern","weight":"strong|medium|weak"}]
#STACKDOG_PHPSHELL_SIGNATURES=/etc/stackdog/php-shell-signatures.json
# PHP2Shell (CVE-2026-109618, CVE-2026-109619): alert on PHP builds older than
# the fixed releases, on the host and in running containers. Alert only.
#STACKDOG_PHP_VERSION_CHECK_ENABLED=true

# ---------------------------------------------------------------------------
# Dashboard container (docker-compose.yml / docker-compose.app.yml)
# ---------------------------------------------------------------------------
# Host:port a browser uses to reach the API. Read by the dashboard container at
# start-up, so a restart is enough — no rebuild.
#STACKDOG_API_HOST=192.0.2.10:5000
# Port the dashboard is published on.
#STACKDOG_UI_PORT=3000
